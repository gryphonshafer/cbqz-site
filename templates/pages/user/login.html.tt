[% page.title = 'Account Login' %]

<h1>[% page.title %]</h1>

<form method="post">
    <fieldset>
        <legend>Login</legend>

        <label>
            Email:
            <input type="email" name="email" value="" placeholder="Email">
        </label>
        <label>
            Password:
            <input type="password" name="passwd" value="" placeholder="Password">
        </label>

        <input type="hidden" name="type" value="login">
        <button type="submit" class="colored">Login</button>
    </fieldset>
</form>

<p><a href="[% c.url_for('/user/forgot_password') %]">Forgot Password</a></p>

<p><i>
    <b>Important Note:</b>
    iCloud and other Apple services have been known to block email from the CBQz.org web site.
    Please use an email address other than from iCloud or other Apple services.
    If you have any difficulties logging in, please contact:
    <a href="mailto:q@cbqz.org">q@cbqz.org</a>
<i></p>
